rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Username index — anyone can read (for availability checks), only auth users can write
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Email index — anyone can read (for login existence checks), only auth users can write
    match /emails/{email} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-user sub-collections (workouts, nutrition, healthMetrics, goals)
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
